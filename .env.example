# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for chat (e.g. google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-haiku)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Base URL for OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Context compression settings:
# 1. Compress context after this total number of messages (user + assistant combined)
COMPRESSION_THRESHOLD=50

# 2. Or compress if estimated tokens reach this limit (even if 50 messages not reached)
TOKEN_TRIGGER_THRESHOLD=8000

# Upper boundary for model context window
MAX_CONTEXT_TOKENS=12000

# Number of most recent messages to keep verbatim after compression (4 = 2 pairs of user/bot)
KEEP_RECENT_MESSAGES=4

# Maximum tokens for summary generation to prevent summary bloat
MAX_SUMMARY_TOKENS=300

# Maximum output tokens for chat response (prevents 402 credit reservation errors on OpenRouter)
MAX_RESPONSE_TOKENS=2000

# SQLite database path
DATABASE_PATH=bot_data.sqlite3
